{
  "author": {
    "email": "demczenko@beliani.co.uk"
  },
  "name": "Prolo power tool-DEVMODE 2",
  "version": "2.0.0",
  "manifest_version": 3,
  "description": "Make prolo great again!",
  "default_locale": "en",
  "icons": {
    "32": "./icons/copy-32.png",
    "64": "./icons/copy-64.png",
    "128": "./icons/copy-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.prologistics.info/news_email.php?id=*"],
      "js": ["./constants.js"]
    },
    {
      "matches": ["https://prolodev.prologistics.info/news_email.php?id=*"],
      "js": ["./dev_constants.js"]
    },
    {
      "matches": ["https://www.prologistics.info/newsletter_preview.html?id=*"],
      "js": ["./content/mustache/index.js", "./content/pages/my_page.js"]
    },
    {
      "matches": [
        "https://prolodev.prologistics.info/*",
        "https://www.prologistics.info/*",
        "https://www.prologistics.info/start.php"
      ],
      "js": ["./content/autoTimeStamp.js", "./content/login/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.prologistics.info/purge.php", "https://prolodev.prologistics.info/purge.php"],
      "js": ["./content/purge/index.js", "./content/newsletter_family/new_features/log.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.prologistics.info/shop_content.php?id=*&shop_id=*"],
      "js": [
        "./content/mustache/index.js",
        "./content/papaParse/papaparse.min.js",
        "./content/context/index.js",
        "./content/components/index.js",

        "./content/templates/landing.js",
        "./content/handlers/handleSelectLandingTemplate.js",

        "./content/select_templates/index.js",
        "./content/select_context/index.js",
        "./content/fulfill_LP/index.js",
        "./content/fix_cp_update/preupdaterFix.js"
      ]
    },
    {
      "matches": [
        "https://www.prologistics.info/news_email.php?id=*",
        "https://prolodev.prologistics.info/news_email.php?id=*"
      ],
      "exclude_matches": ["https://www.prologistics.info/news_email.php?id=*&validate_message=*"],
      "js": [
        "./libraries/jquery.min.js",
        "./libraries/axios.min.js",
        "./libraries/datatable.min.js",

        "./content/newsletter_family/new_features/log.js",
        "./content/newsletter_family/new_features/api.js",
        "./content/newsletter_family/new_features/csvparser.js",
        "./content/newsletter_family/new_features/domHelpers.js",
        "./content/newsletter_family/new_features/index.js",

        "./content/mustache/index.js",
        "./content/papaParse/papaparse.min.js",
        "./content/context/index.js",
        "./content/components/index.js",
        "./content/handlers/handleSelectNewsletterTemplate.js",
        "./content/templates/newsletters.js",

        "./content/newsletter_family/handleLandingUpdate.js",

        "./content/select_template/index.js",
        "./content/select_context/index.js",

        "./content/fulfill_NS/index.js",
        "./content/helpers/CSVfns.js",
        "./content/fulFillServer.js",
        "./content/sendEmailToMe.js",
        "./content/svg.js",
        "./content/newsletter_family/copyCampaignNumber.js",

        "./content/newsletter_family/handleButtonBodyUpdate.js",

        "./content/newsletter_family/features/updateBody.js",
        "./content/newsletter_family/features/fulfillBody.js",
        "./content/newsletter_family/NewsletterFamilyTable.js"
      ],
      "css": ["./libraries/datatable.min.css", "./content/newsletter_family/new_features/index.css"]
    },
    {
      "matches": ["https://www.prologistics.info/news_email.php?id=*&validate_message=*"],
      "run_at": "document_idle",
      "js": ["./content/newsletterCheckPage.js"]
    },
    {
      "matches": [
        "https://www.prologistics.info/news_emails.php",
        "https://prolodev.prologistics.info/news_emails.php"
      ],
      "run_at": "document_idle",
      "js": ["./content/multiselect/index.js", "./content/multiselect/select.js"]
    },
    {
      "matches": [
        "https://www.prologistics.info/shop_banner.php?id=*",
        "https://prolodev.prologistics.info/shop_banner.php?id*"
      ],
      "run_at": "document_idle",
      "js": [
        "./content/mustache/index.js",
        "./content/papaParse/papaparse.min.js",
        "./libraries/dexie.js",
        "./libraries/sweetalert2.min.js",

        "./content/handlers/handleSelectBannerTemplate.js",
        "./content/templates/banners.js",

        "./content/cgb_templates/ui.js",
        "./content/cgb_templates/loader.js",
        "./content/cgb_templates/ui-buttons-and-functions.js",
        "./content/cgb_templates/index.js"
      ],
      "css": ["./content/cgb_templates/style.css", "./libraries/sweetalert2.min.css"]
    },
    {
      "matches": ["https://www.prologistics.info/saved_details.php?filter_id=*"],
      "js": [
        "./content/isActive.js",
        "./content/fetchProducts.js",
        "./content/download.js",
        "./content/selectProductsNew.js",
        "./content/selectProduct.js"
      ]
    },
    {
      "matches": ["https://www.prologistics.info/start.php"],
      "js": [
        "./content/linkifyjs/linkify.js",
        "./content/linkifyjs/linkify-html.min.js",
        "./content/issue.js",
        "./content/issue/nltrChecklistMap.bundle.js"
      ]
    },
    {
      "matches": [
        "https://www.prologistics.info/push_notifications.php",
        "https://prolodev.prologistics.info/push_notifications.php"
      ],
      "js": [
        "./libraries/sweetalert2.min.js",

        "./content/helpers/CSVfns.js",
        "./content/uploadCSV.js",
        "./content/push/macro.js"
      ],
      "css": ["./libraries/sweetalert2.min.css"]
    },
    {
      "matches": ["https://www.prologistics.info/react/logs/issue_logs/*"],
      "js": [
        "./content/emoji/content.js",
        "./content/issue/content.js",
        "./content/issue/layout.js",
        "./content/kanbanTable/content.js"
      ],
      "css": ["./content/emoji/styles.css", "./libraries/gridstack.min.css", "./content/kanbanTable/style.css"]
    },
    {
      "matches": ["https://www.prologistics.info/spam_plan.php*", "https://prolodev.prologistics.info/spam_plan.php*"],
      "js": [
        "./libraries/sweetalert2.min.js",
        "./content/planning/subjectLineDB.js",
        "./content/planning/planning-ui.js",
        "./content/cgb_templates/loader.js",
        "./content/planning/spam_plan.js",
        "./content/planning/planningDate.js"
      ],
      "css":[ "./libraries/sweetalert2.min.css",
              "./content/planning/style.css"]
    },
    {
      "matches": ["https://www.prologistics.info/react/logs/issue_logs/*"],
      "js": ["./libraries/sweetalert2.min.js", 
              "./content/send_nslt/send-ui.js",
              "./content/send_nslt/send.js"],
      "css": ["./libraries/sweetalert2.min.css", "./content/send_nslt/style.css"]
    },
    {
      "matches": ["https://www.sendtric.com/*"],
      "js": [
        "./libraries/jquery.min.js",
        "./content/timer/content.js",
        "./content/timer/setDate.js",
        "./content/timer/setColor.js",
        "./libraries/datatable.min.js"
      ],
      "css": ["./libraries/datatable.min.css"]
    }
  ],
  "background": {
    "service_worker": "./background/sw.js",
    "type": "module"
  },
  "action": {
    "default_title": "Click to view a popup",
    "default_popup": "./build/index.html"
  },
  "externally_connectable": {
    "matches": ["http://localhost:5173/"]
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset",
        "enabled": true,
        "path": "rule.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": ["content/startphp_styles.css", "content/linkifyjs/*.js", "content/send_nslt/game/img/*"],
      "matches": ["https://www.prologistics.info/*", "https://prolodev.prologistics.info/*"]
    }
  ],
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "activeTab",
    "identity",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback"
  ],
  "host_permissions": ["https://www.prologistics.info/*", "https://prolodev.prologistics.info/*"]
}
