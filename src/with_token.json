{
  "author": {
    "email": "demczenko@beliani.co.uk"
  },
  "name": "__MSG_name__",
  "version": "1.0.0",
  "manifest_version": 3,
  "description": "__MSG_description__",
  "default_locale": "en",
  "icons": {
    "32": "./icons/copy-32.png",
    "64": "./icons/copy-64.png",
    "128": "./icons/copy-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.prologistics.info/*"],
      "run_it": "document_idle",
      "all_frames": false,
      "js": [
        "./content/selectProducts.js",
        "./content/selectProduct.js",
        "./content/fulFillServer.js",
        "./content/sendEmailToMe.js",
        "./content/issue.js"
      ]
    },
    {
      "matches": [
        "https://www.prologistics.info/*",
        "https://prolodev.prologistics.info/*"
      ],
      "run_it": "document_idle",
      "all_frames": false,
      "js": ["./content/uploadCSV.js", "./content/copyCampaignNumber.js", "./content/newsletterCheckPage.js"]
    },
    {
      "matches": ["https://www.prologistics.info/*"],
      "run_it": "document_idle",
      "all_frames": false,
      "js": ["./content/fulFillInputs.js"]
    }
  ],
  "background": {
    "service_worker": "./background/service-worker.js",
    "type": "module"
  },
  "commands": {
    "set_subject": {
      "suggested_key": "Ctrl+Shift+S",
      "description": "Run \"subject\" on the current page."
    }
  },
  "oauth2": {
    "client_id": "715521523586-ecrbeb23coiji7bbfa2cth1r0v70v84q.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive",
      "https://www.googleapis.com/auth/spreadsheets"
    ]
  },
  "action": {
    "default_title": "Click to view a popup",
    "default_popup": "./build/index.html"
  },
  "externally_connectable": {
    "matches": ["http://localhost:5173/"]
  },
  "permissions": ["tabs", "storage", "scripting", "activeTab", "identity"],
  "host_permissions": [
    "https://www.prologistics.info/*",
    "https://prolodev.prologistics.info/*",
    "*://*/*"
  ]
}
